NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
MYN_AI_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_MAX_PRICE_ID=
STRIPE_TEAMS_PRICE_ID=
APP_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_ENABLE_GOOGLE=false

# Optional: one-time database installation via Supabase Management API (server-only).
SUPABASE_ACCESS_TOKEN=

# Optional Agent Core provider (server-only). Existing OpenAI binding is reused.
MYN_AGENT_PROVIDER=openai
MYN_AGENT_MODEL=gpt-4.1-mini
# Isolated browser service: use HTTPS in production. Never use NEXT_PUBLIC_ here.
MYN_WORKER_URL=
MYN_WORKER_SECRET=
# Worker process only: set to 1 only after enforcing private-network/metadata egress denial.
MYN_BROWSER_EGRESS_CONFIRMED=
MYN_WORKER_HOST=127.0.0.1
MYN_WORKER_PORT=3040
